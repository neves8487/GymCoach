# ===========================================
# GymCoach — Environment Variables
# ===========================================
# Copy to .env and fill in real values.
# NEVER commit .env with real values.
# ===========================================

# --- Vertex AI / Gemini ---
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# --- WhatsApp Business API ---
WHATSAPP_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token
WHATSAPP_APP_SECRET=your_app_secret_for_signature_validation
WHATSAPP_WABA_ID=your_waba_id

# --- Telegram Bot API ---
TELEGRAM_TOKEN=your_telegram_bot_token



# --- Cloud Storage ---
GCS_BUCKET_NAME=fotos-refeicoes

# --- App ---
LOG_LEVEL=INFO

# --- A2A Sub-agent URLs (geradas por scripts/deploy_agent.py --agent all) ---
# Formato: https://{location}-aiplatform.googleapis.com/v1/{resource_name}/.well-known/agent.json
PT_AGENT_A2A_URL=https://us-central1-aiplatform.googleapis.com/v1/projects/YOUR_PROJECT_NUMBER/locations/us-central1/reasoningEngines/PT_ENGINE_ID/.well-known/agent.json
NUTRITION_AGENT_A2A_URL=https://us-central1-aiplatform.googleapis.com/v1/projects/YOUR_PROJECT_NUMBER/locations/us-central1/reasoningEngines/NUTRITION_ENGINE_ID/.well-known/agent.json

# --- Staging bucket (para deploy dos sub-agentes no Agent Engine) ---
# STAGING_BUCKET=gs://your-staging-bucket
